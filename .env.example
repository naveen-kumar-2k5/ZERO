# ─────────────────────────────────────────────────────
# ZeroRespond backend environment
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Postgres
PG_DB=zerorespong_db
PG_USER=zero
PG_PASSWORD=            # ROTATE the old value; it is public in Git history
PG_HOST=localhost
PG_PORT=5432

# App URLs
WEBHOOK_URL=http://127.0.0.1:5000
UI_URL=http://127.0.0.1:5001
POLLER_STALE_SEC=300

# Wazuh Manager API (for agent inventory + alerts)
WAZUH_HOST=https://192.168.244.131:55000
WAZUH_USER=wazuh-wui
WAZUH_PASS=             # no default — required

# Wazuh Indexer (for vulnerability detection findings)
# Same host as manager in an all-in-one deployment; port 9200.
WAZUH_INDEXER_HOST=https://192.168.244.131:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=     # no default — required for /vulnerabilities
WAZUH_INDEXER_VERIFY=false
WAZUH_INDEXER_TIMEOUT=8
WAZUH_VULN_INDEX=wazuh-states-vulnerabilities-*

# App environment — set to 'production' to fail-fast on missing secrets
APP_ENV=development

# Per-agent shared secrets — MUST match the value exported on each endpoint.
ZR_SECRET_WIN_AGENT1=<the 64-hex-char secret>
ZR_SECRET_LINUX_AGENT1=<the other 64-hex-char secret>